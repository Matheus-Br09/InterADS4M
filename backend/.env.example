APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Em desenvolvimento local da para usar APP_DEBUG=true no seu .env, que nao
# entra no git. Aqui fica false de proposito: quem clonar este repositorio
# e for publicar nao deve herdar tela de erro com valor de variavel de ambiente.

APP_TIMEZONE=America/Recife
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Origem do site publica, separada por virgula. '*' e desenvolvimento.
# ANTES DE PUBLICAR: ponha a origem real, ex.: https://ongsos.org.br
CORS_ALLOWED_ORIGINS=*

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true so quando o acesso e por HTTPS. Ligar em http://localhost desloga
# todo mundo, porque o navegador nao devolve cookie sem TLS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dados da ONG (Pix e contatos). ATENÇÃO: confirmar a chave Pix diretamente com a ONG antes de preencher.
# Formato da chave: CPF/CNPJ só com dígitos (sem pontos nem traço); celular como +55DDDNÚMERO (ex.: +5581999999999);
# e-mail como está; chave aleatória (EVP) exatamente como o banco mostra.
# ONG_PIX_CHAVE=
# ONG_PIX_NOME=
# ONG_PIX_CIDADE=
# ONG_WHATSAPP=5581999999999
# ONG_INSTAGRAM=https://www.instagram.com/sostudopelosocial/
# ONG_EMAIL_GESTAO=
# ONG_DOACAO_EXPIRA_DIAS=7

# ----------------------------------------------------------------------
# Produção (Hostinger): troque os valores acima por estes no .env do servidor
# ----------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://<domínio>
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# CORS_ALLOWED_ORIGINS=https://<domínio>
# TRUSTED_PROXIES=  (IP/faixa do proxy da Hostinger, separados por vírgula; preencha só se o HTTPS ou o IP do visitante não for detectado. Vazio = nenhum proxy confiável)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=<e-mail da ONG na Hostinger>
# MAIL_PASSWORD=<senha do e-mail>  (preencha só no servidor, nunca no git)
# MAIL_FROM_ADDRESS=<e-mail da ONG>
# ONG_PIX_CHAVE, ONG_PIX_NOME, ONG_PIX_CIDADE, ONG_WHATSAPP, ONG_INSTAGRAM, ONG_EMAIL_GESTAO (ver bloco acima)
